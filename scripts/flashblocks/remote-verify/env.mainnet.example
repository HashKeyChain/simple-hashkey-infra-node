# Template. Copy to env.mainnet (or env.qa / env.testnet) and fill in the endpoints
# for that environment. Copies are gitignored; only *.example is tracked.
#
# WARNING: never put the private key here. Pass it via the environment instead:
#   export FB_TEST_KEY=0x…

# User-facing op-reth, flashblocks-aware. Used by verify.sh.
RETH_RPC="https://<env>-reth.example.net"

# Public flashblocks distribution endpoint. Used by ws-verify.sh.
# Note this is NOT the same path the in-cluster op-reth uses. Internally that is
# ws://hsk-flashblocks-ws-proxy-0:1113/ws; this one goes through an extra ingress
# hop, so it has to be verified separately.
WS_URL="wss://<env>-flashblocks-ws.example.net/ws"

# Block time in milliseconds. ws-verify.sh derives all of its thresholds from this.
BLOCK_TIME_MS=2000

# Priority fee for the test transaction, in wei. Defaults to 1 gwei.
# When the chain is idle `cast` estimates a tip as low as 1 wei, which is below the
# sequencer's minimum. Such a transaction sits in the pool and never lands, so this
# acts as a floor.
# TIP_WEI=1000000000

# Everything below is only used by verify.sh; ws-verify.sh does not need it.

# Canonical reference, optional. Point this at a client that does NOT understand
# flashblocks so the script can measure how far ahead the preconfirmation is.
# Leave it empty or set it to the same value as RETH_RPC and you only get a
# pass/fail against PRECONF_MAX_MS, with no lead time measurement.
GETH_RPC="https://<env>-cgt.example.net"

# Upper bound for preconfirmation latency, in milliseconds. Set it to one block
# time (2000 for a 2s chain). A transaction lands at a random phase of the block
# period: early in the period it is confirmed after a single flashblock (~800ms),
# late in the period it waits for the next round (~1700ms). That spread of nearly
# one full period is normal even on a healthy chain, so a threshold shorter than
# the block time will fail perfectly good samples.
# This budget also includes the network round trip from wherever you run the
# script, so widen it when running cross-region.
PRECONF_MAX_MS=2000
