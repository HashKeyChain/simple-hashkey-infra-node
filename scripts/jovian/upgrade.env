# ==============================================================================
# Jovian 升级作用域配置（scoped env）
# ------------------------------------------------------------------------------
# 只放"合约升级/部署"相关、不属于日常起链的变量，避免污染全局 .envrc。
# 由 scripts/jovian/ 下的顶层脚本在 `source .envrc` 之后统一 source（存在才 source）。
#
# 取值优先级（以 deploy-systemconfig.sh 为例）：
#   命令行参数 $1  >  本文件里的值  >  脚本内置默认值
#
# 需要临时试别的分支时，直接命令行传参即可，无需改本文件。
# ==============================================================================

# 合约升级时 contracts-bedrock 要切到的分支/tag（CGT/Jovian 自研分支）
export CONTRACTS_UPGRADE_REF=cgt-jovian/contracts-v2.0.0-beta.3
