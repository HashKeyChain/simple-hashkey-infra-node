# Copy this file to verify.env, then fill in the real values.

L2_RPC="https://REPLACE_ME_L2_RPC"
# Private key used only for sending L2 verification transactions.
L2_VERIFY_PRIVATE_KEY="0xREPLACE_ME"

# Deploy L1 SystemConfig setter config.
# SYSTEM_CONFIG_PRIVATE_KEY must be the direct owner of SystemConfigProxy in this simple verifier.
L1_RPC="https://REPLACE_ME_L1_RPC"
# SystemConfig proxy address.
SYSTEM_CONFIG_PROXY="0xREPLACE_ME_SYSTEM_CONFIG_PROXY"
# Deployer / SystemConfig owner private key.
SYSTEM_CONFIG_PRIVATE_KEY="0xREPLACE_ME"

# External SystemConfig implementation deployment config.
# Repo root of the Optimism monorepo, or an infra repo with nested optimism/.
# Supported layouts:
#   $SYSTEM_CONFIG_CONTRACTS_REPO/packages/contracts-bedrock
#   $SYSTEM_CONFIG_CONTRACTS_REPO/optimism/packages/contracts-bedrock
SYSTEM_CONFIG_CONTRACTS_REPO="/Users/zhuangqianwei/github.com/HashKeyChain/optimism"
SYSTEM_CONFIG_CONTRACTS_REF="cgt-jovian/contracts-v2.0.0-beta.2"

# Explorer source verification after deployment.
SYSTEM_CONFIG_VERIFIER="etherscan"
SYSTEM_CONFIG_ETHERSCAN_API_KEY="REPLACE_ME_ETHERSCAN_API_KEY"
SYSTEM_CONFIG_CHAIN_ID="11155111"

# Set to 0 if you only want to run RPC and transaction checks.
GRANITE_TIME="0"
HOLOCENE_TIME="0"
ISTHMUS_TIME="0"
JOVIAN_TIME="0"

# Expected EIP-1559 params encoded in L2 block extraData after Holocene.
# Set to 0 to only require that the decoded values are non-zero.
EXPECTED_EIP1559_DENOMINATOR="0"
EXPECTED_EIP1559_ELASTICITY="0"

# Values used by the SystemConfig setter scripts.
SET_EIP1559_DENOMINATOR="500"
SET_EIP1559_ELASTICITY="12"
SET_MIN_BASE_FEE="10000"
SET_OPERATOR_FEE_SCALAR="2"
SET_OPERATOR_FEE_CONSTANT="1"
SET_DA_FOOTPRINT_GAS_SCALAR="800"
