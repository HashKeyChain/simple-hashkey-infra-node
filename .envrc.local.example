##################################################
#                 Getting Started                #
##################################################

# Copy this file to .envrc and fill only disposable local-development accounts.
# Never put production keys, tokens, or credentials in this repository.

# Deploy account
export DEPLOY_ADDRESS=
export DEPLOY_PRIVATE_KEY=

# Admin account
export GS_ADMIN_ADDRESS=
export GS_ADMIN_PRIVATE_KEY=

# Batcher account
export GS_BATCHER_ADDRESS=
export GS_BATCHER_PRIVATE_KEY=

# Proposer account
export GS_PROPOSER_ADDRESS=
export GS_PROPOSER_PRIVATE_KEY=

# Sequencer account
export GS_SEQUENCER_ADDRESS=
export GS_SEQUENCER_PRIVATE_KEY=


##################################################
#                Chain Information               #
##################################################

# L1 block time must be >= L2_BLOCK_TIME. A shorter channel duration keeps the safe head
# close enough to the L1 head for op-node restart and fork-activation drills.
export L1_CHAIN_ID=11155111
export L1_BLOCK_TIME=6

export L2_CHAIN_ID=5536
export L2_BLOCK_TIME=2


##################################################
#              op-node Configuration             #
##################################################

# alchemy, quicknode, infura, parity, nethermind, debug_geth, erigon, basic, any.
export L1_RPC_KIND=alchemy


##################################################
#             op-batcher Configuration           #
##################################################

# Local chains have no L1 gas pressure; close channels frequently so the safe head follows L1.
export MAX_CHANNEL_DURATION=5


##################################################
#               Contract Deployment              #
##################################################

export L1_RPC_URL=http://localhost:8545

# op-geth public and Engine API ports.
export OP_GETH_HTTP_PORT=8645
export OP_GETH_WS_PORT=8646
export OP_GETH_AUTHRPC_PORT=8651
export L2_RPC_URL=http://localhost:$OP_GETH_HTTP_PORT

export OP_ROLLUP_PORT=9545
export OP_BATCHER_PORT=9645
export OP_NODE_RPC_URL=http://localhost:$OP_ROLLUP_PORT
export OP_BATCHER_RPC_URL=http://localhost:$OP_BATCHER_PORT


##################################################
#           Component Version References         #
##################################################

export OP_GETH_REF=v1.101605.0
export OP_NODE_REF=cgt-jovian/v1.16.5
export OP_BATCHER_REF=op-batcher/v1.16.3
export OP_PROPOSER_REF=op-proposer/v1.10.0
export OP_CHALLENGER_REF=cgt-jovian/v1.16.5
export OP_PROGRAM_REF=op-contracts/v2.0.0-beta.3
export CANNON_REF=op-contracts/v2.0.0-beta.3
export OP_CONTRACTS_REF=op-contracts/v2.0.0-beta.3

# op-node needs Go 1.22 because fjl/memsize v0.0.2 is incompatible with Go 1.23+.
# op-geth requires Go 1.24, so allow Go to select a newer toolchain for that module.
export GOTOOLCHAIN=go1.22.12+auto


##################################################
#                 Deployment Data                #
##################################################

# Generate a fresh CREATE2 salt for each deployment.
export IMPL_SALT=$(openssl rand -hex 32)

export DEPLOYMENT_CONTEXT=local-mainnet

# Optional external integrations.
export TENDERLY_PROJECT=
export TENDERLY_USERNAME=
export ETHERSCAN_API_KEY=

# Forge deployment key. Keep empty until a disposable funded local key is provided.
export PRIVATE_KEY=

export BASE_PATH=$PWD
export CONTRACTS_BEDROCK_PATH=$BASE_PATH/optimism/packages/contracts-bedrock
export OP_NODE_PATH=$BASE_PATH/optimism/op-node
export PATH=$PATH:$BASE_PATH/bin

# Do not prepend ~/.local-go-toolchains here. macOS may block downloaded binaries and show
# an authorization dialog. Deployment scripts select a working system Go explicitly.

export CONTRACT_ADDRESSES_PATH=""
export CHAIN_ID=$L2_CHAIN_ID
export DEPLOYMENT_CONFIG_PATH=$BASE_PATH/config/$DEPLOYMENT_CONTEXT

export DEPLOY_CONFIG_PATH=$CONTRACTS_BEDROCK_PATH/deploy-config/$DEPLOYMENT_CONTEXT.json
export DEPLOYMENT_OUTFILE=$CONTRACTS_BEDROCK_PATH/deployments/artifact.json
export STATE_DUMP_PATH=$CONTRACTS_BEDROCK_PATH/deployments/state-dump-latest.json
export OP_GETH_GENESIS_FILE=$CONTRACTS_BEDROCK_PATH/deployments/genesis.json
export OP_NODE_ROLLUP_FILE=$CONTRACTS_BEDROCK_PATH/deployments/rollup.json


##################################################
#              Chain Feature Settings            #
##################################################

export USE_CUSTOM_GAS_TOKEN=true
# Leave empty to deploy a fresh CGT on the current L1.
export CUSTOM_GAS_TOKEN_ADDRESS=

export USE_FAULT_PROOFS=true

# 0 = CANNON; 1 = PERMISSIONED_CANNON.
export GAME_TYPE=1
export RESPECTED_GAME_TYPE=$GAME_TYPE

export CONTRACTS_UPGRADE_REF=cgt-jovian/contracts-v2.0.0-beta.3


##################################################
#       Hardfork Activation Times (Source)       #
##################################################

# 0 means active at genesis; empty means not scheduled. activate-fork.sh derives both
# rollup.json and genesis.json from these values.
export FORK_FJORD_TIME=0
export FORK_GRANITE_TIME=
export FORK_HOLOCENE_TIME=
export FORK_ISTHMUS_TIME=
export FORK_JOVIAN_TIME=


##################################################
#                    Flashblocks                 #
##################################################

# off / dry_run / enabled.
export FLASHBLOCKS_MODE=off

export RB_ENGINE_PORT=8551
export RB_FLASHBLOCKS_WS_PORT=1112
export RB_DEBUG_PORT=5555
export RB_METRICS_PORT=9090

export RBUILDER_AUTHRPC_PORT=8661
export RBUILDER_HTTP_PORT=8663
export RBUILDER_WS_PORT=8664
export RBUILDER_FB_WS_PORT=1111
export RBUILDER_P2P_PORT=30313

export FB_PROXY_PORT=1113
export FB_RPC_HTTP_PORT=8745
export FB_RPC_AUTHRPC_PORT=8751
export FB_RPC_OPNODE_PORT=9555
export FB_RPC_P2P_PORT=30323
export FB_RPC_OPNODE_P2P_TCP_PORT=9224

export RBUILDER_OPNODE_PORT=9565
export SEQ_P2P_TCP_PORT=9222
export RBUILDER_OPNODE_P2P_TCP_PORT=9223

export ROLLUP_BOOST_REF=v0.7.11
export OP_RBUILDER_REF=op-rbuilder/v0.2.13
export OP_RETH_REF=v1.9.3
