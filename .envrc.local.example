##################################################
#              op-node Configuration             #
##################################################

# The kind of RPC provider, used to inform optimal transactions receipts
# fetching. Valid options: alchemy, quicknode, infura, parity, nethermind,
# debug_geth, erigon, basic, any.
export L1_RPC_KIND=alchemy

# ===== op-node Engine 端点（默认直连 op-geth；可指向中间件代理）=====
# 不设置时，scripts/run-op-node.sh 拼出 --l2=http://localhost:8651，
# 即直连本机 op-geth 的 authrpc —— 与不加本变量时的历史行为逐字节一致。
#
# 设置后，op-node 的 Engine 流量改发给该地址。用于在 op-node 与执行层之间插入
# 透明代理（如 engine-api-proxy）：代理拦截 engine_getPayload* 的响应、算出区块
# payloadHash 落库，再把请求原样转发给 op-geth。
#
# 注意：不能靠导出 op-node 自带的 OP_NODE_L2_ENGINE_RPC 来改。urfave/cli 的命令行
# 优先级高于 EnvVars，只要启动脚本仍然拼出 --l2=，该环境变量就会被忽略。
#
# 代理的 JWT 与 op-geth 共用 data/op-geth/jwt.txt（chain-start.sh 生成），
# 入站校验与出站签发都指向它即可。
# 启动顺序：代理需先于 op-node 起（op-node 启动时会 ping 签名器的 health_status）；
# 「代理 → op-geth → op-node」是安全的，因为代理只在收到第一个请求时才连上游。
# export L2_ENGINE_URL=http://127.0.0.1:8661

# ===== op-node 远端区块签名器（默认关闭，用本地私钥签名）=====
# 留空（默认）时，run-op-node.sh 下发 --p2p.sequencer.key=$GS_SEQUENCER_PRIVATE_KEY
# 与 --p2p.disable，与历史行为一致。
#
# 设置 OP_SIGNER_ENDPOINT 后，脚本会自动：
#   1. 去掉 --p2p.sequencer.key —— 必须去掉，否则 op-node 会以
#      "cannot specify both a private key and a remote signer for sequencer p2p"
#      拒绝启动（见 op-node/p2p/cli/load_signer.go）。
#   2. 追加 --signer.endpoint / --signer.address / --signer.tls.enabled=true
#      以及 --signer.tls.ca/cert/key（取自下面三个变量）。
#   3. 把 p2p 从禁用改成"启用但不对外"（--p2p.disable=false --p2p.no-discovery
#      --p2p.listen.ip=127.0.0.1），并打开 metrics。
#
# 上面第 3 条是这套配置里最要命的一条，务必别自己改回去：
#   p2p 被禁用时 op-node 的 SignAndPublishL2Payload（op-node/node/node.go:803）
#   直接 return nil，**远端签名器一次都不会被调用**；而 initP2PSigner（node.go:264）
#   是无条件执行的，op-node 照样连上签名器并打印 "Connected to op-signer server"。
#   于是链正常出块、签名器连着、发布错误计数恒为 0 —— 全绿，但签名链路一次没走过。
#   run-op-node.sh 在启动前会断言这个组合不存在，撞上会直接拒绝启动。
#   另外签名失败只体现在 op-node 的 publishing_errors 计数上（区块签名跑在独立
#   goroutine 里，出块循环不等它、也不看它），所以远端签名时 metrics 必须开着。
#
# 端点写法有两个硬约束，都是实测踩出来的：
#   - **scheme 必须是 https**。go-ethereum 的 rpc 传输层按 URL scheme 决定要不要
#     TLS，写 http:// 时客户端证书配了也不会被用到，发出去是明文请求，撞上
#     op-signer 的 TLS 监听直接握手失败。写 http:// 时脚本会拒绝启动。
#   - **主机名必须匹配签名器证书的 DNS SAN**。证书通常只签 DNS SAN（localhost）、
#     没有 IP SAN，所以 127.0.0.1 不行、localhost 才行（同样解析到回环，
#     "只绑回环" 的约束不受影响）。
#
# 还有一条：op-signer 是无条件 mTLS，它的 auth 中间件在 tls.enabled=false 时同样
# 要求客户端叶证书，**没有明文模式**，所以 --signer.tls.enabled=false 这个组合
# 永远连不上（连启动时的 health_status 都过不去）。
#
# 远端签名器只有 endpoint 与 address 同时非空才算启用
# （op-service/signer 的 CLIConfig.Enabled()），故脚本总是成对下发；
# OP_SIGNER_ADDRESS 不设时默认取 $GS_SEQUENCER_ADDRESS。
# export OP_SIGNER_ENDPOINT=https://localhost:8570
# export OP_SIGNER_ADDRESS=$GS_SEQUENCER_ADDRESS
# mTLS 凭据，三项必须成套给（只给一部分时 op-node 会去用它自己的默认相对路径
# tls/ca.crt、tls/tls.crt、tls/tls.key，那是另一种难查的失败）。
# export OP_SIGNER_TLS_CA=/abs/path/ca.crt
# export OP_SIGNER_TLS_CERT=/abs/path/tls.crt
# export OP_SIGNER_TLS_KEY=/abs/path/tls.key
# op-node metrics 端口（远端签名时自动开启，默认 7300）。
# export OP_NODE_METRICS_PORT=7300

##################################################
#               Contract Deployment              #
##################################################

# RPC URL for the L1 network to interact with
export L1_RPC_URL=http://localhost:8545
export L2_RPC_URL=http://localhost:8645
export OP_ROLLUP_PORT=9545
export OP_BATCHER_PORT=9645
export OP_NODE_RPC_URL=http://localhost:$OP_ROLLUP_PORT
export OP_BATCHER_RPC_URL=http://localhost:$OP_BATCHER_PORT

##################################################
#           Component Version References         #
##################################################

# op-geth version (from ethereum-optimism/op-geth releases)
export OP_GETH_REF=v1.101605.0

# op-node version: local CGT Jovian branch.
# It includes Isthmus/Jovian upgrade transaction bytecode replacements for
# L1Block/GasPriceOracle and related gas adjustments.
export OP_NODE_REF=cgt-jovian/v1.16.5

# op-batcher version
export OP_BATCHER_REF=op-batcher/v1.16.3

# op-proposer version
export OP_PROPOSER_REF=op-proposer/v1.10.0

# op-challenger version: use cgt-jovian/v1.16.5 (same branch / Prague-aware op-geth
# as op-node). A pre-Prague op-geth would miscompute L1 header hashes (EIP-7685
# requestsHash) and break hash-based eth_call against a live L1.
export OP_CHALLENGER_REF=cgt-jovian/v1.16.5

# op-program version (for fault proofs)
# Kept at beta.3 to stay compatible with the deployed MIPS / absolute prestate.
export OP_PROGRAM_REF=op-contracts/v2.0.0-beta.3

# cannon version (for fault proofs)
export CANNON_REF=op-contracts/v2.0.0-beta.3

# contracts-bedrock version
export OP_CONTRACTS_REF=op-contracts/v2.0.0-beta.3

# Contracts branch/ref used for contract upgrades
export CONTRACTS_UPGRADE_REF=cgt-jovian/contracts-v2.0.0-beta.3

# Go toolchain:
#  - op-node(optimism monorepo) go.mod requires go 1.21, but go 1.23+
#    is incompatible with fjl/memsize v0.0.2 (link: invalid reference to runtime.stopTheWorld),
#    so use go 1.22 for op-node.
#  - op-geth v1.101605.0 go.mod requires go 1.24.
#  Use "go1.22.12+auto": minimum 1.22.12, auto-upgrade when go.mod requires newer.
export GOTOOLCHAIN=go1.22.12+auto

##################################################

# Salt used via CREATE2 to determine implementation addresses
# NOTE: If you want to deploy contracts from scratch you MUST reload this
#       variable to ensure the salt is regenerated and the contracts are
#       deployed to new addresses (otherwise deployment will fail)
export IMPL_SALT=$(openssl rand -hex 32)

# Name for the deployed network
export DEPLOYMENT_CONTEXT=local-mainnet

# Optional Tenderly details for simulation link during deployment
export TENDERLY_PROJECT=
export TENDERLY_USERNAME=

# Optional Etherscan API key for contract verification
export ETHERSCAN_API_KEY=

# Private key to use for contract deployments, you don't need to worry about
# this for the Getting Started guide.
# 0x70997970C51812dc3A010C7d01b50e0d17dc79C8, the account is from anvil's default test account.
export PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# base path, used for the project
export BASE_PATH=$PWD
export CONTRACTS_BEDROCK_PATH=$BASE_PATH/optimism/packages/contracts-bedrock
export OP_NODE_PATH=$BASE_PATH/optimism/op-node
export PATH=$PATH:$BASE_PATH/bin

# contracts-bedrock relate paths
export CONTRACT_ADDRESSES_PATH=""
export CHAIN_ID=$L2_CHAIN_ID

# Generated paths for the deployment context.
export DEPLOYMENT_CONFIG_PATH=$BASE_PATH/config/$DEPLOYMENT_CONTEXT

# The generated files.
export DEPLOY_CONFIG_PATH=$CONTRACTS_BEDROCK_PATH/deploy-config/$DEPLOYMENT_CONTEXT.json
export DEPLOYMENT_OUTFILE=$CONTRACTS_BEDROCK_PATH/deployments/artifact.json
export STATE_DUMP_PATH=$CONTRACTS_BEDROCK_PATH/deployments/state-dump-latest.json
export OP_GETH_GENESIS_FILE=$CONTRACTS_BEDROCK_PATH/deployments/genesis.json
export OP_NODE_ROLLUP_FILE=$CONTRACTS_BEDROCK_PATH/deployments/rollup.json

# custom gas token. Fields: useCustomGasToken, customGasTokenAddress
export USE_CUSTOM_GAS_TOKEN=true
# Leave empty to let deploy-contracts.sh deploy a fresh CGT and fill the address.
# Set this only when reusing a token that already exists on the current L1.
export CUSTOM_GAS_TOKEN_ADDRESS=

# Choice to use L2OutputOracle or FaultDisputeGame, false: L2OutputOracle, true: FaultDisputeGame. Field: useFaultProofs
export USE_FAULT_PROOFS=true

# Dispute game type (only used when USE_FAULT_PROOFS=true):
#   0 = CANNON (permissionless, anyone can propose/challenge)
#   1 = PERMISSIONED_CANNON (permissioned, only authorized proposer/challenger)
# New chains start permissioned per official production practice: Portal.respectedGameType,
# the proposer's --game-type and the anchor init script all follow this variable.
export GAME_TYPE=1
export RESPECTED_GAME_TYPE=$GAME_TYPE

# ===== Hardfork activation times (single source of truth) =====
# Configure once here. These FORK_*_TIME values are the single source of truth for
# fork activation; both consumers derive from them:
#   - rollup.json *_time: written by scripts/patch-rollup-config.sh (read by op-node)
#   - op-geth --override.*: assembled at startup by scripts/run-op-geth.sh (read by op-geth)
# Both go through scripts/lib/fork-times.sh, which is where the accepted forms and the
# reason behind them are documented in full.
#
# Accepted forms:
#   +N        offset from L2 genesis (genesis l2_time + N seconds). PREFERRED.
#   <integer> absolute unix seconds (the only option for a real network's fixed schedule).
#   0         active at genesis.
#   empty     fork not scheduled (rollup.json null, no op-geth override).
#
# 为什么推荐 +N：创世时间每次 chain-reset + chain-setup 重建链都会变。写绝对秒就必须
# 每次人工按新创世时间重算这几个数字，漏算一次就是「分叉不晚于创世」，后果是 op-geth
# 起来就 panic: integer divide by zero，一个块都出不来（成因见 lib/fork-times.sh）。
# 写 +N 时重建链不需要任何人工介入；就算坚持写绝对秒，fork-times.sh 也会在启动前把
# 这个致命组合拦下来，不会再静默炸在运行时。
#
# 提示：下面 granite 之后的 4 项在模板里是留空的，照模板原样建出来的链只到 fjord。
# 若要验证 Jovian（也是生产当前所处的分叉），把这 4 项填成 +60/+62/+64/+66 之类的偏移
# 再跑 chain-setup.sh —— 它会调用 patch-rollup-config.sh 把解析后的绝对秒写进 rollup.json。
# 填好 .envrc 跑一次 chain-setup.sh 就够，不需要单独跑 activate-fork.sh；
# 但它不清 data/op-geth，换创世前要先跑 chain-reset.sh。
export FORK_FJORD_TIME=0
export FORK_GRANITE_TIME=
export FORK_HOLOCENE_TIME=
export FORK_ISTHMUS_TIME=
export FORK_JOVIAN_TIME=
